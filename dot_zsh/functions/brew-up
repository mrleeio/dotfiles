# Refresh Homebrew metadata, then upgrade installed formulae and casks.
emulate -L zsh

if ! (( $+commands[brew] )); then
  print -u2 -- 'brew-up: Homebrew is not installed or not on PATH.'
  return 1
fi

brew update && brew upgrade || return
# Pick up new completions in the next shell.
rm -f "${XDG_CACHE_HOME:-$HOME/.cache}"/zsh/zcompdump-*(N)
