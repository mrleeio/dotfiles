# Explicit dependency setup; never invoked during shell or editor startup.
emulate -L zsh

local tool source_dir
for tool in chezmoi python3 git nvim; do
  if ! (( $+commands[$tool] )); then
    print -u2 -- "vim-up: missing $tool; install the Brewfile dependencies first."
    return 1
  fi
done
source_dir=$(chezmoi source-path) || return

python3 - "$source_dir/dependencies.json" <<'PYTHON'
import json
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

STAGING_PREFIX = ".vim-up-"


def git(*args):
    return subprocess.run(["git", *args], check=True, capture_output=True, text=True).stdout


def install(repository, revision, destination):
    if destination.exists():
        try:
            toplevel = git("-C", str(destination), "rev-parse", "--show-toplevel").strip()
        except subprocess.CalledProcessError:
            toplevel = None
        if toplevel is None or Path(toplevel).resolve() != destination.resolve():
            raise RuntimeError("exists but is not a Git checkout; remove it to reinstall")
        if git("-C", str(destination), "ls-files"):
            print(f"Keeping existing checkout: {destination}")
            return
        # An empty index means an earlier clone stopped before checkout. Git refuses
        # to overwrite untracked files, so local edits survive a failed completion.
        print(f"Completing interrupted checkout: {destination}")
        git("-C", str(destination), "checkout", "--detach", revision)
        return
    parent = destination.parent
    parent.mkdir(parents=True, exist_ok=True)
    for stale in parent.glob(f"{STAGING_PREFIX}*"):
        shutil.rmtree(stale, ignore_errors=True)
    # Stage beside the destination so publishing the finished checkout is one rename.
    with tempfile.TemporaryDirectory(prefix=STAGING_PREFIX, dir=parent) as staging:
        checkout = Path(staging) / destination.name
        git("clone", "--no-checkout", repository, str(checkout))
        git("-C", str(checkout), "checkout", "--detach", revision)
        checkout.rename(destination)
    print(f"Installed: {destination}")


failed = False
for dependency in json.loads(Path(sys.argv[1]).read_text()):
    destination = Path(dependency["directory"]).expanduser()
    try:
        install(dependency["repository"], dependency["revision"], destination)
    except (subprocess.CalledProcessError, RuntimeError) as error:
        detail = getattr(error, "stderr", None) or str(error)
        print(f"vim-up: {destination}: {detail.strip()}", file=sys.stderr)
        failed = True
sys.exit(1 if failed else 0)
PYTHON
local result=$?
(( result == 0 )) || return $result
# Pick up new plugin completions in the next shell.
rm -f "${XDG_CACHE_HOME:-$HOME/.cache}"/zsh/zcompdump-*(N)

nvim --headless \
  -c "lua local ok, result = pcall(function() return require('nvim-treesitter').install(require('treesitter_languages')):wait(300000) end); if not ok or result == false then print('Parser installation failed: ' .. tostring(result)); vim.cmd('cquit 1') end" \
  -c 'qa'
