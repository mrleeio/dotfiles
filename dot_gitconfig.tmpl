[init]
  defaultBranch = main
[push]
  default = current
  autoSetupRemote = true
  followTags = true
[pull]
  ff = only
[fetch]
  prune = true
  pruneTags = true
[merge]
  ff = only
  conflictstyle = zdiff3
[rebase]
  autosquash = true
  autoStash = true
  updateRefs = true
[rerere]
  enabled = true
[diff]
  algorithm = histogram
  colorMoved = zebra
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
  gpgSign = true
[column]
  ui = auto
[help]
  autocorrect = prompt
[color]
  ui = auto
[core]
  excludesfile = ~/.gitignore
  autocrlf = input
  editor = nvim
[commit]
  gpgsign = true
  verbose = true
[gpg]
  format = ssh
[gpg "ssh"]
  program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
  allowedSignersFile = ~/.ssh/allowed_signers
[credential]
  helper = osxkeychain
[user]
  name = "{{ (index .machines .machine_name).name }}"
  email = "{{ (index .machines .machine_name).email }}"
  signingkey = {{ (index .machines .machine_name).signingkey }}
[alias]
  aa = add --all
  ap = add --patch
  branches = for-each-ref --sort=-committerdate --format=\"%(color:blue)%(authordate:relative)\t%(color:red)%(authorname)\t%(color:white)%(color:bold)%(refname:short)\" refs/remotes
  ci = commit -v
  co = checkout
  pf = push --force-with-lease
  st = status
[include]
  path = ~/.gitconfig.local
