{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [],
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.gnupg",
        "~/.config/gcloud",
        "~/.kube",
        "~/.config/atuin/key",
        "~/.config/chezmoi/key.txt",
        "~/.docker/config.json",
        "~/.netrc",
        "~/.npmrc",
        "~/.gem/credentials",
        "~/.claude/.credentials.json",
        "~/.claude.json",
        "/**/.env",
        "/**/.env.*",
        "/**/secrets/**"
      ],
      "denyWrite": [
        "/etc",
        "/private/etc",
        "/usr/local",
        "/opt/homebrew",
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.config/gcloud",
        "~/.kube",
        "~/.config/chezmoi",
        "~/.config/gh",
        "~/.docker",
        "~/Library/Keychains",
        "~/.claude/settings.json",
        "~/.claude/settings.local.json",
        "~/.claude.json",
        "~/.zshenv",
        "~/.zprofile",
        "~/.zshrc",
        "~/.bash_profile",
        "~/.bashrc",
        "~/.profile",
        "~/.gitconfig",
        "~/.netrc",
        "~/.npmrc",
        "~/.gem/credentials"
      ],
      "disabled": false
    },
    "network": {
      "allowAllUnixSockets": false,
      "allowLocalBinding": true,
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "rubygems.org",
        "*.rubygems.org",
        "api.anthropic.com",
        "api.githubcopilot.com",
        "raw.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "proxy.golang.org",
        "sum.golang.org",
        "formulae.brew.sh",
        "ghcr.io",
        "*.ghcr.io",
        "registry-1.docker.io",
        "auth.docker.io",
        "production.cloudflare.docker.com",
        "mise.jdx.dev",
        "luarocks.org",
        "atuin.sh",
        "*.amazonaws.com",
        "*.aws.amazon.com",
        "*.awsapps.com"
      ]
    },
    "failIfUnavailable": true,
    "enableWeakerNestedSandbox": false,
    "enableWeakerNetworkIsolation": false,
    "allowAppleEvents": false,
    "credentials": {
      "envVars": [
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "CLAUDE_CODE_OAUTH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "OPENAI_API_KEY",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NODE_AUTH_TOKEN",
          "mode": "deny"
        }
      ]
    }
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(~/GitHub/**)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(doas *)",
      "Bash(su *)",
      "Bash(diskutil eraseDisk *)",
      "Bash(diskutil eraseVolume *)",
      "Bash(diskutil partitionDisk *)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean * -f*)",
      "Bash(git clean -df*)",
      "Bash(git clean -xf*)",
      "Bash(git clean -dxf*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(gh repo delete *)",
      "Bash(gh auth token *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/atuin/key)",
      "Read(~/.config/chezmoi/key.txt)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.gem/credentials)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/secrets/**)",
      "Edit(//etc)",
      "Edit(//private/etc)",
      "Edit(//usr/local)",
      "Edit(//opt/homebrew)",
      "Edit(~/.ssh)",
      "Edit(~/.aws)",
      "Edit(~/.gnupg)",
      "Edit(~/.config/gcloud)",
      "Edit(~/.kube)",
      "Edit(~/.config/chezmoi)",
      "Edit(~/.config/gh)",
      "Edit(~/.docker)",
      "Edit(~/Library/Keychains)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude.json)",
      "Edit(~/.zshenv)",
      "Edit(~/.zprofile)",
      "Edit(~/.zshrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.bashrc)",
      "Edit(~/.profile)",
      "Edit(~/.gitconfig)",
      "Edit(~/.netrc)",
      "Edit(~/.npmrc)",
      "Edit(~/.gem/credentials)",
      "Edit(//etc/**)",
      "Edit(//private/etc/**)",
      "Edit(//usr/local/**)",
      "Edit(//opt/homebrew/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.config/gcloud/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.config/chezmoi/**)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.docker/**)",
      "Edit(~/Library/Keychains/**)",
      "Edit(//**/.env)",
      "Edit(//**/.env.*)",
      "Edit(//**/secrets/**)"
    ]
  },
  "env": {
    "AWS_EC2_METADATA_DISABLED": "true"
  }
}
